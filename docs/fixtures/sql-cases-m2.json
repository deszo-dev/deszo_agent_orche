  "cases": [
    {
      "id": "migration-preserves-runs",
      "expected": "accept",
      "sql": "SELECT id,state,journal_version FROM runs ORDER BY id",
      "rows": [
        [
          "r1",
          "succeeded",
          1
        ],
        [
          "r2",
          "failed",
          1
        ],
        [
          "r3",
          "draining",
          1
        ],
        [
          "r4",
          "queued",
          1
        ],
        [
          "r5",
          "queued",
          1
        ]
      ]
    },
    {
      "id": "foreign-keys-still-resolve",
      "expected": "accept",
      "sql": "SELECT COUNT(*) FROM journal_events JOIN runs ON runs.id = journal_events.run_id",
      "rows": [
        [
          1
        ]
      ]
    },
    {
      "id": "scoped-instances-repeat-node-id",
      "expected": "accept",
      "sql": "INSERT INTO node_instances VALUES (?,?,?,?,?)",
      "params": [
        "r1",
        "refine/2/proposal",
        "proposal",
        "agent",
        "scheduled"
      ]
    },
    {
      "id": "instance-identity-still-unique",
