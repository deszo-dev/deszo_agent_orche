  "failurePolicy": [
    {
      "id": "first-failure",
      "state": "running",
      "action": "attempt_failed",
      "runningSiblings": 1,
      "expected": {
        "state": "draining",
        "dispatch": false,
        "cancelSiblings": false
      }
    },
    {
      "id": "later-failure",
      "state": "draining",
      "action": "attempt_failed",
      "runningSiblings": 1,
      "expected": {
        "state": "draining",
        "dispatch": false,
        "cancelSiblings": false
      }
    },
    {
      "id": "drain-complete",
      "state": "draining",
      "action": "siblings_finished",
      "runningSiblings": 0,
      "expected": {
        "state": "failed",
        "dispatch": false,
        "cancelSiblings": false
      }
    },
    {
      "id": "explicit-stop-draining",
      "state": "draining",
      "action": "root_stop",
      "runningSiblings": 1,
      "expected": {
        "state": "stopping",
        "dispatch": false,
        "cancelSiblings": true
      }
    },
    {
      "id": "failure-and-context-review",
      "state": "running",
      "action": "attempt_failed",
      "runningSiblings": 1,
      "bindingState": "writing",
      "nativeMayHaveAdvanced": true,
      "expected": {
        "state": "draining",
        "dispatch": false,
        "cancelSiblings": false,
        "bindingState": "needs_review"
      }
    }
  ],
  "contextAvailability": [
    {
      "id": "reject-reviewed-context-at-creation",
      "stage": "create_continue",
      "bindingState": "needs_review",
      "expected": {
        "runState": null,
        "attemptState": null,
        "bindingState": "needs_review",
        "error": "context_unavailable"
      }
    },
    {
      "id": "ready-context-can-create-run",
      "stage": "create_continue",
      "bindingState": "ready",
      "expected": {
        "runState": "queued",
        "attemptState": null,
        "bindingState": "ready",
        "error": null
      }
    },
    {
      "id": "review-found-before-dispatch",
      "stage": "dispatch",
      "bindingState": "needs_review",
      "expected": {
        "runState": "draining",
        "attemptState": "failed",
        "bindingState": "needs_review",
        "error": "context_unavailable"
      }
    }
  ],
