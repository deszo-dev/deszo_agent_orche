{
  "schemaVersion": 1,
  "workflowId": "round-recovery-delivery",
  "capabilities": [
    "core-v1",
    "loops-v1",
    "pipeline-v1",
    "delivery-v1"
  ],
  "settings": {
    "nativeConfiguration": "restricted"
  },
  "nodes": [
    {
      "id": "documentation",
      "type": "file-input",
      "config": {
        "mode": "files",
        "paths": [
          "SPEC.md",
          "spec-index.json",
          "implementation-map.json"
        ]
      }
    },
    {
      "id": "project",
      "type": "file-input",
      "config": {
        "mode": "files",
        "paths": [
          "src/api.mjs",
          "fixtures/tokens.json"
        ]
      }
    },
    {
      "id": "no-issues",
      "type": "merge",
      "config": {
        "mode": "record",
        "inputs": [],
        "fields": [
          {
            "name": "issues",
            "source": {
              "literal": []
            }
          }
        ]
      }
    },
    {
      "id": "issue-list",
      "type": "json-select",
      "config": {
        "pointer": "/issues",
        "outputType": "JsonValue"
      }
    },
    {
      "id": "prepare",
      "type": "gate",
      "config": {
        "mode": "prepare",
        "policy": {
          "slots": [
            {
              "id": "customer",
              "role": "customer",
              "view": "public"
            },
            {
              "id": "readiness",
              "role": "implementation-readiness",
              "view": "full"
            },
            {
              "id": "testability",
              "role": "testability-reviewer",
              "view": "full"
            }
          ]
        }
      }
    },
    {
      "id": "plan-text",
      "type": "json-select",
      "config": {
        "pointer": "",
        "outputType": "Text",
        "render": "canonical-json"
      }
    },
    {
      "id": "customer-prompt",
      "type": "prompt-template",
      "config": {
        "template": "Review the public business view as the Customer.\n\nReview plan (JSON):\n{{plan}}\n\nReturn a ReviewDecision for the subject in SUBJECT.json. Resolve in resolvedIssueIds every open issue listed in your slot's resolvableIssueIds that this revision fixes; never resolve another reviewer's issue.",
        "slots": [
          {
            "id": "plan"
          }
        ]
      }
    },
    {
      "id": "customer-review",
      "type": "agent",
      "config": {
        "provider": "codex",
        "model": "explicit-test-model",
        "timeoutSeconds": 600,
        "output": {
          "format": "json",
          "schema": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "subjectId": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9-]*$"
              },
              "role": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "verdict": {
                "enum": [
                  "APPROVED",
                  "CHANGES_REQUESTED"
                ]
              },
              "scopeRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9-]*$"
                },
                "uniqueItems": true
              },
              "resolvedIssueIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9-]*$"
                },
                "uniqueItems": true
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "localId": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                    },
                    "severity": {
                      "enum": [
                        "blocker",
                        "suggestion"
                      ]
                    },
                    "ownerRole": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "requirementRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9-]*$"
                      },
                      "uniqueItems": true
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "requestedChange": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "localId",
                    "severity",
                    "ownerRole",
                    "requirementRefs",
                    "message",
                    "requestedChange"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "schemaVersion",
              "subjectId",
              "role",
              "verdict",
              "scopeRefs",
              "resolvedIssueIds",
              "issues"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "verdict": {
                      "const": "CHANGES_REQUESTED"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "issues": {
                      "contains": {
                        "properties": {
                          "severity": {
                            "const": "blocker"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "verdict": {
                      "const": "APPROVED"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "issues": {
                      "items": {
                        "properties": {
                          "severity": {
                            "const": "suggestion"
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "attachFiles": true
      }
    },
    {
      "id": "readiness-prompt",
      "type": "prompt-template",
      "config": {
        "template": "Review the full bundle for implementation readiness.\n\nReview plan (JSON):\n{{plan}}\n\nReturn a ReviewDecision for the subject in SUBJECT.json. Resolve in resolvedIssueIds every open issue listed in your slot's resolvableIssueIds that this revision fixes; never resolve another reviewer's issue.",
