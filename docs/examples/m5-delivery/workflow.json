    {
      "id": "evaluate",
      "type": "gate",
      "config": {
        "mode": "evaluate",
        "policy": {
          "slots": [
            {
              "id": "customer",
              "role": "customer",
              "view": "public"
            },
            {
              "id": "readiness",
              "role": "implementation-readiness",
              "view": "full"
            },
            {
              "id": "testability",
              "role": "testability-reviewer",
              "view": "full"
            }
          ]
        }
      }
    },
    {
      "id": "analyst-history",
      "type": "context",
      "config": {
        "provider": "codex",
        "mode": "new"
      }
    },
    {
      "id": "implement",
      "type": "map",
      "config": {
        "approvalPolicy": {
          "slots": [
            {
              "id": "customer",
              "role": "customer",
              "view": "public"
            },
            {
              "id": "readiness",
              "role": "implementation-readiness",
              "view": "full"
            },
            {
              "id": "testability",
              "role": "testability-reviewer",
              "view": "full"
            }
          ]
        },
        "optionalInputs": [],
        "limits": {
          "maxFailedVerificationCycles": 3,
          "maxTaskAttempts": 3
        },
        "roles": [
          {
            "id": "implementer",
            "kind": "agent",
            "provider": "claude",
            "model": "explicit-test-model",
            "instructions": "Implement the approved task. Write only the listed outputs.",
            "timeoutSeconds": 600,
            "context": "task"
          },
          {
            "id": "test-author",
            "kind": "agent",
            "provider": "antigravity",
            "model": "explicit-test-model",
            "instructions": "Write the approved tests. Write only the listed outputs.",
            "timeoutSeconds": 600,
            "context": "task"
          },
          {
            "id": "reviewer",
            "kind": "agent",
            "provider": "codex",
            "model": "explicit-test-model",
            "instructions": "Review the supplied immutable task-result snapshot against the named criterion and its specification sections. This snapshot contains the base and declared task dependencies, not every parallel task's outputs. For a test-source review, assess required case coverage and compatibility with the documented interfaces. Candidate-sourced check commands are run by the engine verification task after assembly; do not reject an isolated test-writing result because another task's implementation modules are absent. Missing declared inputs and genuine source defects remain blockers. The complete candidate must still pass every approved verification command.",
            "timeoutSeconds": 600,
            "context": "task"
          },
          {
            "id": "analyst",
            "kind": "agent",
            "provider": "codex",
            "model": "explicit-test-model",
            "instructions": "Triage the failed verification from the captured evidence.",
            "timeoutSeconds": 600,
            "context": {
              "contextId": "analyst-history"
            }
          },
          {
            "id": "verification",
            "kind": "utility",
            "template": "verification",
            "embeddedRoles": {
              "triage": "analyst"
            }
          }
        ]
      }
    },
    {
      "id": "outcome",
      "type": "route",
      "config": {
        "valueType": "ArtifactSet",
        "selector": "/outcome",
        "cases": [
          {
            "id": "complete",
            "equals": "implementation_complete"
          },
          {
            "id": "revise",
            "equals": "specification_revision_required"
          }
        ],
        "onUnmatched": "error"
      }
    },
    {
      "id": "candidate-view",
      "type": "result-viewer",
      "config": {}
    },
    {
      "id": "revision-view",
      "type": "result-viewer",
      "config": {}
    },
    {
      "id": "summary-view",
      "type": "result-viewer",
      "config": {}
    }
  ],
