{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deszo.local/documentation/runtime-api-v2.schema.json",
  "title": "API v2 request and response definitions (additive through M6)",
  "$defs": {
    "ref": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "format": "uuid"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifactId",
        "sha256"
      ],
      "additionalProperties": false
    },
    "problem": {
      "$ref": "runtime-api.schema.json#/$defs/problem"
    },
    "createRun": {
      "type": "object",
      "properties": {
        "workflowId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "workflowSnapshotSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "publishedVersionId": {
          "type": "string",
          "format": "uuid"
        },
        "definitionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "mode": {
          "enum": [
            "workflow",
            "branch",
            "node"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "refreshCaches": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "controlGrantId": {
          "type": "string",
          "format": "uuid",
          "description": "ADR-0002: an approved supervision grant bound to this run before its first launch."
        },
        "hostPermitId": {
          "type": "string",
          "format": "uuid",
          "description": "ADR-0006: a Local Control Host permit for run.approve. The engine admits it with the host before creating the run; the request JSON alone grants nothing."
        }
      },
      "required": [
        "workflowId",
        "workflowSnapshotSha256",
        "publishedVersionId",
        "definitionDigest",
        "workspaceId",
        "requestId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "branch",
                  "node"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "targets"
            ]
          },
          "else": {
            "not": {
              "required": [
                "targets"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "node"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "targets": {
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "validation": {
      "$ref": "runtime-api.schema.json#/$defs/validation"
    },
    "savedWorkflow": {
      "$ref": "runtime-api.schema.json#/$defs/savedWorkflow"
    },
    "workflows": {
      "$ref": "runtime-api.schema.json#/$defs/workflows"
    },
    "workspaces": {
      "$ref": "runtime-api.schema.json#/$defs/workspaces"
    },
    "workspace": {
      "$ref": "runtime-api.schema.json#/$defs/workspace"
    },
    "workspaceRequest": {
      "$ref": "runtime-api.schema.json#/$defs/workspaceRequest"
    },
    "listQuery": {
      "$ref": "runtime-api.schema.json#/$defs/listQuery"
    },
    "stopRequest": {
      "$ref": "runtime-api.schema.json#/$defs/stopRequest"
    },
    "capabilities": {
      "$ref": "runtime-api.schema.json#/$defs/capabilities"
    },
    "contextBinding": {
      "$ref": "runtime-api.schema.json#/$defs/contextBinding"
    },
    "contextBindings": {
      "$ref": "runtime-api.schema.json#/$defs/contextBindings"
    },
    "acknowledgeContext": {
      "$ref": "runtime-api.schema.json#/$defs/acknowledgeContext"
    },
    "applicationSettings": {
      "$ref": "runtime-api.schema.json#/$defs/applicationSettings"
    },
    "updateApplicationSettings": {
      "$ref": "runtime-api.schema.json#/$defs/updateApplicationSettings"
    },
    "runSettings": {
      "$ref": "runtime-api.schema.json#/$defs/runSettings"
    },
    "runContextBinding": {
      "type": "object",
      "properties": {
        "contextNodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}(/[1-9][0-9]{0,3}/[a-z][a-z0-9-]{0,63})*$"
        },
        "mode": {
          "enum": [
            "new",
            "continue"
          ]
        },
        "bindingId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "contextNodeId",
        "mode",
        "bindingId"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "workflowId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "workflowSnapshot": {
          "$ref": "#/$defs/ref"
        },
        "executionHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "draining",
            "waiting_for_user",
            "stopping",
            "succeeded",
            "failed",
            "canceled",
            "interrupted"
          ]
        },
        "lastSequence": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "controlMode": { "enum": ["supervised", "unsupervised"] },
        "kind": {
          "enum": [
            "workflow",
            "chat"
          ]
        },
        "publishedVersion": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "publishedVersionId": { "type": "string", "format": "uuid" },
                "version": { "type": "integer", "minimum": 1 },
                "definitionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "authorityPolicyVersion": { "type": "string", "minLength": 1 }
              },
              "required": ["publishedVersionId", "version", "definitionDigest", "authorityPolicyVersion"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "runId",
        "workflowId",
        "workflowSnapshot",
        "executionHash",
        "state",
        "lastSequence",
        "createdAt",
        "workspaceId",
        "kind",
        "publishedVersion"
      ],
      "additionalProperties": false
    },
    "acceptRun": {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "created"
        },
        "run": {
          "$ref": "#/$defs/run"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "outcome",
        "run",
        "requestId"
      ],
      "additionalProperties": false
    },
    "pendingRun": {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "confirmation_pending"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "statusPath": {
          "type": "string",
          "pattern": "^/api/v2/run-requests/[0-9a-fA-F-]{36}$"
        }
      },
      "required": [
        "outcome",
        "requestId",
        "statusPath"
      ],
      "additionalProperties": false
    },
    "runs": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "runListQuery": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "draining",
            "waiting_for_user",
            "stopping",
            "succeeded",
            "failed",
            "canceled",
            "interrupted"
          ]
        },
        "kind": {
          "enum": [
            "workflow",
            "chat"
          ]
        },
        "bindingId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "stopResponse": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "draining",
            "waiting_for_user",
            "stopping",
            "succeeded",
            "failed",
            "canceled",
            "interrupted"
          ]
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "runId",
        "state",
        "requestId"
      ],
      "additionalProperties": false
    },
    "loopExecution": {
      "type": "object",
      "properties": {
        "loopNodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}(/[1-9][0-9]{0,3}/[a-z][a-z0-9-]{0,63})*$"
        },
        "state": {
          "enum": [
            "running",
            "paused",
            "finished",
            "failed",
            "canceled",
            "interrupted"
          ]
        },
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "maxActiveMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "activeMs": {
          "type": "integer",
          "minimum": 0
        },
        "pauseReason": {
          "anyOf": [
            {
              "enum": [
                "iteration_limit",
                "time_limit",
                "body_failure",
                "stopped"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "loopNodeId",
        "state",
        "iteration",
        "maxIterations",
        "maxActiveMinutes",
        "activeMs",
        "pauseReason"
      ],
      "additionalProperties": false
    },
    "runSnapshot": {
      "type": "object",
      "properties": {
        "run": {
          "$ref": "#/$defs/run"
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nodeInstanceId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}(/[1-9][0-9]{0,3}/[a-z][a-z0-9-]{0,63})*$"
              },
              "nodeId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "state": {
                "enum": [
                  "scheduled",
                  "waiting",
                  "running",
                  "succeeded",
                  "failed",
                  "canceled",
                  "blocked",
                  "interrupted",
                  "reused",
                  "skipped"
                ]
              },
              "attemptId": {
                "type": "string",
                "format": "uuid"
              },
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "outputs": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ref"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "nodeInstanceId",
              "nodeId",
              "state",
              "attemptId",
              "ordinal",
              "outputs"
            ],
            "additionalProperties": false
          }
        },
        "contexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runContextBinding"
          }
        },
        "loops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loopExecution"
          }
        },
        "maps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mapExecution"
          }
        },
        "controlMode": {
          "enum": [
            "supervised",
            "unsupervised"
          ],
          "description": "ADR-0002: supervised only while an active grant is bound to the run."
        }
      },
      "required": [
        "run",
        "instances",
        "contexts",
        "loops"
      ],
      "additionalProperties": false
    },
    "linkRepairRequest": {
      "type": "object",
      "description": "ADR-0008 Suspend: suspend a waiting parent run and create its linked repair run in a different workspace. The Engine validates both workflows and the candidate identity.",
      "properties": {
        "requestId": { "type": "string", "format": "uuid" },
        "failedNodeInstanceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "repairWorkflowId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "repairWorkflowSnapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "repairWorkspaceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "candidateDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "continuationCheckpointId": { "type": "string", "pattern": "^chk-[a-z0-9-]{1,60}$" }
      },
      "required": ["requestId", "failedNodeInstanceId", "repairWorkflowId", "repairWorkflowSnapshotSha256", "repairWorkspaceId", "candidateDigest", "continuationCheckpointId"],
      "additionalProperties": false
    },
    "parentRepairCoordinationRequest": {
      "type": "object",
      "description": "Owner-authorized Parent suspension and linked Repair request. The Engine pins both published versions, records the incident and safe retry policy, and accepts only the named Repair result digest before resuming the original Parent.",
      "properties": {
        "requestId": { "type": "string", "format": "uuid" },
        "incidentId": { "type": "string", "format": "uuid" },
        "failedNodeInstanceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "repairWorkflowId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "repairWorkflowSnapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "repairWorkspaceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "repairResultNodeInstanceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "expectedRepairResultSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "failedNodeRetry": { "enum": ["explicit_safe", "never"] }
      },
      "required": ["requestId", "incidentId", "failedNodeInstanceId", "repairWorkflowId", "repairWorkflowSnapshotSha256", "repairWorkspaceId", "repairResultNodeInstanceId", "expectedRepairResultSha256", "failedNodeRetry"],
      "additionalProperties": false
    },
    "lifecycleReceiptRequest": {
      "type": "object",
      "description": "ADR-0008 Lifecycle receipt: the Host's verified outcome of application.activate_candidate for one lifecycle operation. Accepted only for the operation's own candidate digest.",
      "properties": {
        "requestId": { "type": "string", "format": "uuid" },
        "operationId": { "type": "string", "format": "uuid" },
        "candidateDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "outcome": { "enum": ["verified"] },
        "receiptId": { "type": "string", "format": "uuid" }
      },
      "required": ["requestId", "operationId", "candidateDigest", "outcome", "receiptId"],
      "additionalProperties": false
    },
    "recoveryRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "enum": [
            "retry",
            "raise-limit",
            "restart-iteration",
            "close",
            "raise-map-limit"
          ]
        },
        "nodeInstanceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}(/[1-9][0-9]{0,3}/[a-z][a-z0-9-]{0,63})*$"
        },
        "loopNodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}(/[1-9][0-9]{0,3}/[a-z][a-z0-9-]{0,63})*$"
        },
        "binding": {
          "enum": [
            "keep",
            "acknowledge",
            "fresh"
          ]
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "maxActiveMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "maxFailedVerificationCycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxTaskAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "requestId",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "retry"
              }
            }
          },
          "then": {
            "required": [
              "nodeInstanceId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "loopNodeId"
                  ]
                },
                {
                  "required": [
                    "maxIterations"
                  ]
                },
                {
                  "required": [
                    "maxActiveMinutes"
                  ]
                },
                {
                  "required": [
                    "maxFailedVerificationCycles"
                  ]
                },
                {
                  "required": [
                    "maxTaskAttempts"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "raise-limit"
              }
            }
          },
          "then": {
            "required": [
              "loopNodeId",
              "maxIterations",
              "maxActiveMinutes"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "nodeInstanceId"
                  ]
                },
                {
                  "required": [
                    "binding"
                  ]
                },
                {
                  "required": [
                    "maxFailedVerificationCycles"
                  ]
                },
                {
                  "required": [
                    "maxTaskAttempts"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "restart-iteration"
              }
            }
          },
          "then": {
            "required": [
              "loopNodeId"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "nodeInstanceId"
                  ]
                },
                {
                  "required": [
                    "binding"
                  ]
                },
                {
                  "required": [
                    "maxIterations"
                  ]
                },
                {
                  "required": [
                    "maxFailedVerificationCycles"
                  ]
                },
                {
                  "required": [
                    "maxTaskAttempts"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "close"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "nodeInstanceId"
                  ]
                },
                {
                  "required": [
                    "loopNodeId"
                  ]
                },
                {
                  "required": [
                    "binding"
                  ]
                },
                {
                  "required": [
                    "maxIterations"
                  ]
                },
                {
                  "required": [
                    "maxFailedVerificationCycles"
                  ]
                },
                {
                  "required": [
                    "maxTaskAttempts"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "raise-map-limit"
              }
            }
          },
          "then": {
            "required": [
              "nodeInstanceId",
              "maxFailedVerificationCycles",
              "maxTaskAttempts"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "loopNodeId"
                  ]
                },
                {
                  "required": [
                    "binding"
                  ]
                },
                {
                  "required": [
                    "maxIterations"
                  ]
                },
                {
                  "required": [
                    "maxActiveMinutes"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "nodeStopRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "requestId"
      ],
      "additionalProperties": false
    },
    "commandResponse": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "draining",
            "waiting_for_user",
            "stopping",
            "succeeded",
            "failed",
            "canceled",
            "interrupted"
          ]
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "runId",
        "state",
        "requestId"
      ],
      "additionalProperties": false
    },
    "cachePin": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "value": {
          "$ref": "value.schema.json"
        },
        "sourceRunId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceAttemptId": {
          "type": "string",
          "format": "uuid"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceChanged": {
          "type": "boolean"
        },
        "pinnedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "nodeId",
        "value",
        "sourceRunId",
        "sourceAttemptId",
        "fingerprint",
        "sourceChanged",
        "pinnedAt"
      ],
      "additionalProperties": false
    },
    "cachePins": {
      "type": "object",
      "properties": {
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cachePin"
          }
        }
      },
      "required": [
        "pins"
      ],
      "additionalProperties": false
    },
    "freezeCacheRequest": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "nodeInstanceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "runId",
        "nodeInstanceId"
      ],
      "additionalProperties": false
    },
    "chatRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\[\\]-]*$"
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 5
        }
      },
      "required": [
        "requestId",
        "workspaceId",
        "model",
        "prompt"
      ],
      "additionalProperties": false
    },
    "failureOutcomePage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "outcome": { "$ref": "failure-outcome.schema.json" },
              "firstSequence": { "type": ["integer", "null"], "minimum": 1 },
              "latestSequence": { "type": ["integer", "null"], "minimum": 1 }
            },
            "required": ["outcome", "firstSequence", "latestSequence"],
            "additionalProperties": false
          }
        },
        "nextCursor": { "type": ["integer", "null"], "minimum": 1 },
        "cursor": { "type": "integer", "minimum": 0 },
        "legacyCoverage": {
          "type": "object",
          "properties": {
            "status": { "const": "untyped" },
            "source": { "const": "journal" },
            "untypedFailureCount": { "type": "integer", "minimum": 0 }
          },
          "required": ["status", "source", "untypedFailureCount"],
          "additionalProperties": false
        }
      },
      "required": ["items", "nextCursor", "cursor", "legacyCoverage"],
      "additionalProperties": false
    },
    "mapExecution": {
      "type": "object",
      "properties": {
        "mapInstanceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}(/[1-9][0-9]{0,3}/[a-z][a-z0-9-]{0,63})*$"
        },
        "mapExecutionId": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "running",
            "paused",
            "finishing",
            "implementation_complete",
            "specification_revision_required",
            "canceled",
            "interrupted"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "failedVerificationCycles": {
          "type": "integer",
          "minimum": 0
        },
        "maxFailedVerificationCycles": {
          "type": "integer",
          "minimum": 1
        },
        "pauseReason": {
          "anyOf": [
            {
              "enum": [
                "verification_limit",
                "task_attempt_limit",
                "triage_unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "mapInstanceId",
        "mapExecutionId",
        "state",
        "generation",
        "failedVerificationCycles",
        "maxFailedVerificationCycles",
        "pauseReason",
        "accepted",
        "total"
      ],
      "additionalProperties": false
    },
    "mapNavigator": {
      "$ref": "map.schema.json#/$defs/navigator"
    },
    "mapHistory": {
      "$ref": "map.schema.json#/$defs/history"
    }
  }
}
