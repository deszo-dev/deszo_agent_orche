                  "enum": [
                    "queued",
                    "running",
                    "draining",
                    "waiting_for_user",
                    "stopping",
                    "succeeded",
                    "failed",
                    "canceled",
                    "interrupted"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "to": {
              "enum": [
                "queued",
                "running",
                "draining",
                "waiting_for_user",
                "stopping",
                "succeeded",
                "failed",
                "canceled",
                "interrupted"
              ]
