            "executionHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "settingsSnapshot": {
              "$ref": "#/$defs/ref"
            }
          },
          "required": [
            "workflowSnapshot",
            "executionHash",
            "settingsSnapshot"
          ],
          "additionalProperties": false
        },
        "nodeInstanceId": {
          "type": "null"
        },
        "attemptId": {
          "type": "null"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "run.state_changed"
