{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deszo.local/documentation/journal-event.schema.json",
  "title": "M1 durable run event",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nodeInstanceId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attemptId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "runId",
    "sequence",
    "timestamp",
    "nodeInstanceId",
    "attemptId",
    "type",
    "payload"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "run.created"
        },
        "payload": {
          "type": "object",
          "properties": {
            "workflowSnapshot": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "sha256"
              ],
              "additionalProperties": false
            },
            "executionHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "settingsSnapshot": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "workflowSnapshot",
            "executionHash",
            "settingsSnapshot"
          ],
          "additionalProperties": false
        },
        "nodeInstanceId": {
          "type": "null"
        },
        "attemptId": {
          "type": "null"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "run.state_changed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "from": {
              "anyOf": [
                {
                  "enum": [
                    "queued",
                    "running",
                    "draining",
                    "stopping",
                    "succeeded",
                    "failed",
                    "canceled",
                    "interrupted"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "to": {
              "enum": [
                "queued",
                "running",
                "draining",
                "stopping",
                "succeeded",
                "failed",
                "canceled",
                "interrupted"
              ]
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "from",
            "to",
            "reason"
          ],
          "additionalProperties": false
        },
        "nodeInstanceId": {
          "type": "null"
        },
        "attemptId": {
          "type": "null"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "node.planned"
        },
        "payload": {
          "type": "object",
          "properties": {
            "nodeId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "nodeType": {
              "type": "string"
            }
          },
          "required": [
            "nodeId",
            "nodeType"
          ],
          "additionalProperties": false
        },
        "nodeInstanceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "attemptId": {
          "type": "null"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "attempt.state_changed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "from": {
              "anyOf": [
                {
                  "enum": [
                    "scheduled",
                    "waiting",
                    "running",
                    "succeeded",
                    "failed",
                    "canceled",
                    "blocked",
                    "interrupted"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "to": {
              "enum": [
                "scheduled",
                "waiting",
                "running",
                "succeeded",
                "failed",
                "canceled",
                "blocked",
                "interrupted"
              ]
            },
            "reason": {
              "type": "string"
            },
            "process": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "pid": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "startIdentity": {
                      "type": "string",
                      "minLength": 1
                    },
                    "supervisorGeneration": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "pid",
                    "startIdentity",
                    "supervisorGeneration"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "from",
            "to",
            "reason",
            "process"
          ],
          "additionalProperties": false
        },
        "attemptId": {
          "type": "string",
          "format": "uuid"
        },
        "nodeInstanceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "attempt.inputs_committed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "manifest": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "sha256"
              ],
              "additionalProperties": false
            },
            "prompt": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "artifactId",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "contextBindingId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "manifest",
            "prompt",
            "contextBindingId"
          ],
          "additionalProperties": false
        },
        "attemptId": {
          "type": "string",
          "format": "uuid"
        },
        "nodeInstanceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "attempt.invocation_committed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "manifest": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "manifest"
          ],
          "additionalProperties": false
        },
        "attemptId": {
          "type": "string",
          "format": "uuid"
        },
        "nodeInstanceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "attempt.log_chunk"
        },
        "payload": {
          "type": "object",
          "properties": {
            "stream": {
              "enum": [
                "stdout",
                "stderr",
                "normalized"
              ]
            },
            "chunk": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "sha256"
              ],
              "additionalProperties": false
            },
            "chunkIndex": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "stream",
            "chunk",
            "chunkIndex"
          ],
          "additionalProperties": false
        },
        "attemptId": {
          "type": "string",
          "format": "uuid"
        },
        "nodeInstanceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "attempt.outputs_committed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "manifest": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "manifest"
          ],
          "additionalProperties": false
        },
        "attemptId": {
          "type": "string",
          "format": "uuid"
        },
        "nodeInstanceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "attempt.error"
        },
        "payload": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "authentication",
                "quota",
                "billing_policy",
                "provider_unavailable",
                "permission",
                "timeout",
                "process",
                "output_contract",
                "context_unavailable",
                "corruption",
                "interrupted"
              ]
            },
            "message": {
              "type": "string"
            },
            "evidence": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "artifactId",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "message",
            "evidence"
          ],
          "additionalProperties": false
        },
        "attemptId": {
          "type": "string",
          "format": "uuid"
        },
        "nodeInstanceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "context.state_changed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "bindingId": {
              "type": "string",
              "format": "uuid"
            },
            "from": {
              "enum": [
                "unbound",
                "ready",
                "writing",
                "needs_review",
                "unavailable"
              ]
            },
            "to": {
              "enum": [
                "unbound",
                "ready",
                "writing",
                "needs_review",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "bindingId",
            "from",
            "to",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "context.bound"
        },
        "payload": {
          "type": "object",
          "properties": {
            "bindingId": {
              "type": "string",
              "format": "uuid"
            },
            "provider": {
              "enum": [
                "codex",
                "claude",
                "antigravity"
              ]
            },
            "nativeSessionRef": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "sha256"
              ],
              "additionalProperties": false
            },
            "cwdIdentity": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "bindingId",
            "provider",
            "nativeSessionRef",
            "cwdIdentity"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "run.capacity_changed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "settings": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "format": "uuid"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "revision",
            "settings"
          ],
          "additionalProperties": false
        },
        "nodeInstanceId": {
          "type": "null"
        },
        "attemptId": {
          "type": "null"
        }
      },
      "required": [
        "type",
        "payload"
      ]
    }
  ]
}
