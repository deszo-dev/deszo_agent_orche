{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deszo.local/documentation/acceptance-record.schema.json",
  "title": "Criterion-to-Evidence Acceptance Record (ADR-0004)",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "AcceptanceRecord" },
    "recordId": { "type": "string" },
    "deliveryBoundary": { "enum": ["candidate", "verified_branch"] },
    "subjectId": { "type": "string", "minLength": 1 },
    "candidateDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "accepter": {
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "effort": { "type": "string" },
        "contextId": { "type": "string" },
        "independent": { "type": "boolean" }
      },
      "required": ["role", "provider", "model", "effort", "contextId", "independent"],
      "additionalProperties": false
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "criterionId": { "type": "string", "minLength": 1 },
          "requirementRef": { "type": "string", "minLength": 1 },
          "status": { "enum": ["satisfied", "unsatisfied", "unverified"] },
          "reason": { "type": "string", "minLength": 1 },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": { "enum": ["check", "artifact", "observation", "commit"] },
                "id": { "type": "string" },
                "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "required": ["kind", "id", "digest"],
              "additionalProperties": false
            }
          }
        },
        "required": ["criterionId", "requirementRef", "status", "reason", "evidenceRefs"],
        "additionalProperties": false
      }
    },
    "overallStatus": { "enum": ["accepted", "rejected", "incomplete"] },
    "unresolvedLimitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evaluatedAt": { "type": "string", "format": "date-time" }
  },
  "required": [
    "schemaVersion", "kind", "recordId", "deliveryBoundary", "subjectId",
    "candidateDigest", "accepter", "criteria", "overallStatus",
    "unresolvedLimitations", "evaluatedAt"
  ],
  "additionalProperties": false
}
