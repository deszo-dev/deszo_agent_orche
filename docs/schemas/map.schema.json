{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deszo.local/documentation/map.schema.json",
  "title": "Implementation Map execution records (through M6)",
  "$defs": {
    "ref": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "format": "uuid"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifactId",
        "sha256"
      ],
      "additionalProperties": false
    },
    "recordRef": {
      "type": "object",
      "properties": {
        "recordId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "artifact": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "recordId",
        "artifact"
      ],
      "additionalProperties": false
    },
    "issueDraft": {
      "type": "object",
      "properties": {
        "localId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "severity": {
          "enum": [
            "blocker",
            "suggestion"
          ]
        },
        "requirementRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "uniqueItems": true
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "requestedChange": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "localId",
        "severity",
        "requirementRefs",
        "message",
        "requestedChange"
      ],
      "additionalProperties": false
    },
    "taskReturn": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "kind": {
              "const": "candidate"
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "schemaVersion",
            "kind",
            "summary"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "kind": {
              "const": "specification_revision_required"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "issues": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/issueDraft"
                  },
                  {
                    "properties": {
                      "severity": {
                        "const": "blocker"
                      },
                      "requirementRefs": {
                        "minItems": 1
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": [
            "schemaVersion",
            "kind",
            "reason",
            "issues"
          ],
          "additionalProperties": false
        }
      ]
    },
    "taskReview": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "resultId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "criterionId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "verdict": {
          "enum": [
            "APPROVED",
            "CHANGES_REQUESTED"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issueDraft"
          }
        }
      },
      "required": [
        "schemaVersion",
        "taskId",
        "resultId",
        "criterionId",
        "verdict",
        "issues"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "CHANGES_REQUESTED"
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "contains": {
                  "properties": {
                    "severity": {
                      "const": "blocker"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "APPROVED"
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "items": {
                  "properties": {
                    "severity": {
                      "const": "suggestion"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "triageDecision": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "cause": {
          "enum": [
            "implementation",
            "tests",
            "specification",
            "integration_conflict",
            "unknown"
          ]
        },
        "subjectId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "affectedTaskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "uniqueItems": true
        },
        "requirementRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "localId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "severity": {
                "const": "blocker"
              },
              "ownerRole": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "requirementRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9-]*$"
                },
                "uniqueItems": true
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "requestedChange": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "localId",
              "severity",
              "ownerRole",
              "requirementRefs",
              "message",
              "requestedChange"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "cause",
        "subjectId",
        "affectedTaskIds",
        "requirementRefs",
        "reason",
        "issues"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "cause": {
                "enum": [
                  "implementation",
                  "tests",
                  "integration_conflict"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "affectedTaskIds": {
                "minItems": 1
              },
              "issues": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cause": {
                "const": "specification"
              }
            }
          },
          "then": {
            "properties": {
              "requirementRefs": {
                "minItems": 1
              },
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "mapRepair": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "MapRepair"
        },
        "subjectId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "taskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "pipeline-state.schema.json#/$defs/issue"
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "subjectId",
        "taskIds",
        "issues"
      ],
      "additionalProperties": false
    },
    "fileOperation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "create"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "$ref": "#/$defs/ref"
            },
            "byteSize": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "path",
            "artifact",
            "byteSize"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "replace"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "preimage": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "artifact": {
              "$ref": "#/$defs/ref"
            },
            "byteSize": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "path",
            "preimage",
            "artifact",
            "byteSize"
          ],
          "additionalProperties": false
        }
      ]
    },
    "taskResult": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "TaskResult"
        },
        "recordId": {
          "type": "string",
          "pattern": "^RES-[A-F0-9]{12}$"
        },
        "mapExecutionId": {
          "type": "string",
          "format": "uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "subjectId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "attempt": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "format": "uuid"
            },
            "nodeInstanceId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}(/[1-9][0-9]{0,3}/[a-z][a-z0-9-]{0,63})*$"
            },
            "attemptId": {
              "type": "string",
              "format": "uuid"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "requestedModel": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "observedModel": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "runId",
            "nodeInstanceId",
            "attemptId",
            "role",
            "requestedModel",
            "observedModel"
          ],
          "additionalProperties": false
        },
        "templateRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "ref",
              "digest"
            ],
            "additionalProperties": false
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileOperation"
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "fileSet"
                  },
                  "manifest": {
                    "$ref": "#/$defs/ref"
                  }
                },
                "required": [
                  "type",
                  "manifest"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "candidate"
                  },
                  "record": {
                    "$ref": "#/$defs/recordRef"
                  }
                },
                "required": [
                  "type",
                  "record"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "json",
                      "text"
                    ]
                  },
                  "artifact": {
                    "$ref": "#/$defs/ref"
                  }
                },
                "required": [
                  "type",
                  "artifact"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "taskReturn": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "recordId",
        "mapExecutionId",
        "generation",
        "subjectId",
        "taskId",
        "attempt",
        "templateRevision",
        "inputs",
        "operations",
        "outputs",
        "taskReturn"
      ],
      "additionalProperties": false
    },
    "taskReviewRecord": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "TaskReview"
        },
        "recordId": {
          "type": "string",
          "pattern": "^TREV-[A-F0-9]{12}$"
        },
        "mapExecutionId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "resultId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "criterionId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "verdict": {
          "enum": [
            "APPROVED",
            "CHANGES_REQUESTED"
          ]
        },
        "decision": {
          "$ref": "#/$defs/ref"
        },
        "reviewer": {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "format": "uuid"
            },
            "nodeInstanceId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}(/[1-9][0-9]{0,3}/[a-z][a-z0-9-]{0,63})*$"
            },
            "attemptId": {
              "type": "string",
              "format": "uuid"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "requestedModel": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "observedModel": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "runId",
            "nodeInstanceId",
            "attemptId",
            "role",
            "requestedModel",
            "observedModel"
          ],
          "additionalProperties": false
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "pipeline-state.schema.json#/$defs/issue"
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "recordId",
        "mapExecutionId",
        "taskId",
        "resultId",
        "criterionId",
        "verdict",
        "decision",
        "reviewer",
        "issues"
      ],
      "additionalProperties": false
    },
    "checkReport": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "CheckReport"
        },
        "recordId": {
          "type": "string",
          "pattern": "^CHK-[A-F0-9]{12}$"
        },
        "mapExecutionId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "criterionId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "checkId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "subjectId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "candidate",
                "task-result"
              ]
            },
            "recordId": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9-]*$"
            }
          },
          "required": [
            "kind",
            "recordId"
          ],
          "additionalProperties": false
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "executableVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "requiredExitCode": {
          "type": "integer"
        },
        "exitCode": {
          "type": "integer"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        },
        "stdout": {
          "$ref": "#/$defs/ref"
        },
        "stderr": {
          "$ref": "#/$defs/ref"
        },
        "sourceIntegrity": {
          "const": "intact"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "recordId",
        "mapExecutionId",
        "taskId",
        "criterionId",
        "checkId",
        "subjectId",
        "source",
        "executable",
        "executableVersion",
        "arguments",
        "timeoutSeconds",
        "requiredExitCode",
        "exitCode",
        "startedAt",
        "endedAt",
        "stdout",
        "stderr",
        "sourceIntegrity",
        "outcome"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "Candidate"
        },
        "recordId": {
          "type": "string",
          "pattern": "^CAND-[A-F0-9]{12}$"
        },
        "mapExecutionId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "base": {
          "$ref": "#/$defs/ref"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recordRef"
          }
        },
        "manifest": {
          "$ref": "#/$defs/ref"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "from": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "path",
              "sha256",
              "from"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "recordId",
        "mapExecutionId",
        "taskId",
        "base",
        "results",
        "manifest",
        "paths"
      ],
      "additionalProperties": false
    },
    "conflict": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "Conflict"
        },
        "recordId": {
          "type": "string",
          "pattern": "^CONF-[A-F0-9]{12}$"
        },
        "mapExecutionId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "base": {
          "$ref": "#/$defs/ref"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recordRef"
          }
        },
        "conflicts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "enum": [
                  "different_content",
                  "preimage_mismatch",
                  "case_collision"
                ]
              },
              "results": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9-]*$"
                }
              }
            },
            "required": [
              "path",
              "reason",
              "results"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "recordId",
        "mapExecutionId",
        "taskId",
        "base",
        "results",
        "conflicts"
      ],
      "additionalProperties": false
    },
    "triage": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "Triage"
        },
        "recordId": {
          "type": "string",
          "pattern": "^TRI-[A-F0-9]{12}$"
        },
        "mapExecutionId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
