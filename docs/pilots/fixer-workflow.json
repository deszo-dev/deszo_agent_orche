                      }
                    },
                    "problem": {
                      "type": "string"
                    },
                    "nextSuggestion": {
                      "type": "string"
                    },
                    "noProgressKey": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "summary",
                    "changedPaths",
                    "checks",
                    "evidence",
                    "problem",
                    "nextSuggestion",
                    "noProgressKey"
                  ],
                  "additionalProperties": false
                }
              ]
            },
