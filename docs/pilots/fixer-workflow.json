                          },
                          "outcome": {
                            "type": "string",
                            "enum": [
                              "passed",
                              "failed",
                              "not_run"
                            ]
                          },
                          "exitCode": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "evidencePath": {
                            "type": [
                              "string",
                              "null"
                            ]
