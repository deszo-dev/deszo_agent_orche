                        "minLength": 1
                      },
                      "nextTask": {
                        "type": "string",
                        "minLength": 1
                      },
                      "expectedEvidence": {
                        "type": "string",
                        "minLength": 1
                      },
                      "issueSummary": {
                        "type": "string"
                      },
                      "attemptedApproaches": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "outcome",
                      "reason",
                      "nextTask",
                      "expectedEvidence",
                      "issueSummary",
                      "attemptedApproaches"
                    ],
                    "additionalProperties": false
                  }
                }
              }
